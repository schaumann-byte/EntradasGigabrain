{
  "_comment": "Léxico do realizador por regras (variante A). 'phrases': expressões formais típicas de SRS -> equivalente coloquial (a maioria troca só palavras funcionais). 'contractions': contrações do inglês falado (não alteram tokens de conteúdo). 'doc_refs': regex de referências ao próprio documento, removidas da fala.",
  "phrases": {
    "in order to": "to",
    "prior to": "before",
    "subsequent to": "after",
    "in the event that": "if",
    "in the event of": "in case of",
    "in the case of": "for",
    "approximately": "about",
    "a minimum of": "at least",
    "a maximum of": "at most",
    "no less than": "at least",
    "no more than": "at most",
    "is capable of": "can handle",
    "are capable of": "can handle",
    "has the ability to": "can",
    "have the ability to": "can",
    "shall have the capability to": "should be able to",
    "provide the capability to": "let people",
    "provide the ability to": "let people",
    "utilize": "use",
    "utilizes": "uses",
    "utilized": "used",
    "utilizing": "using",
    "commence": "start",
    "commences": "starts",
    "sufficient": "enough",
    "numerous": "lots of",
    "additional": "extra",
    "obtain": "get",
    "obtains": "gets",
    "purchase": "buy",
    "assist": "help",
    "assists": "helps",
    "regarding": "about",
    "with respect to": "about",
    "therefore": "so",
    "however": "but",
    "e.g.": "like",
    "i.e.": "that is",
    "etc.": "and so on",
    "and/or": "or",
    "via": "through",
    "furthermore": "also",
    "moreover": "also",
    "whereby": "where",
    "thereof": "of it",
    "at all times": "always",
    "in addition": "also",
    "a number of": "a bunch of"
  },
  "contractions": {
    "do not": "don't",
    "does not": "doesn't",
    "is not": "isn't",
    "are not": "aren't",
    "cannot": "can't",
    "can not": "can't",
    "will not": "won't",
    "should not": "shouldn't",
    "would not": "wouldn't",
    "must not": "mustn't",
    "it is": "it's",
    "that is": "that's",
    "there is": "there's",
    "we would": "we'd",
    "we will": "we'll",
    "we are": "we're",
    "they are": "they're",
    "I would": "I'd",
    "it will": "it'll",
    "you will": "you'll",
    "let us": "let's"
  },
  "doc_refs": [
    ",?\\s*\\((?:see|refer to|cf\\.?|as (?:described|specified|defined) in)[^)]*\\)",
    ",?\\s*(?:as (?:described|specified|defined|shown|listed) in|see|refer to)\\s+(?:section|table|figure|appendix|chapter|paragraph)\\s+[\\w.\\-]+",
    "\\s*\\[(?:[A-Z]{1,6}[-_ ]?\\d+[^\\]]*)\\]"
  ]
}
